# Free, instant, no card: https://fredaccount.stlouisfed.org/apikeys
# Used for US macro releases (10Y yield, CPI, Fed funds) as event flags.
FRED_API_KEY=

# ── Narration providers ──────────────────────────────────────────────────────
# Tried in this order. Gemini's free tier is preferred for the simple view,
# which is a long generation run once per symbol per session - across 52
# symbols that is real money on a paid API and nothing on a free one.
#
# https://aistudio.google.com/apikey   (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://platform.openai.com/api-keys   (fallback, and default for the short
# technical narration on the Forecast tab)
OPENAI_API_KEY=
NARRATOR_MODEL=gpt-5-mini
NARRATOR_REASONING_EFFORT=low

# Ingest, features, modelling and the full walk-forward report all run with
# no language-model key at all. Only the two narration surfaces need one.
