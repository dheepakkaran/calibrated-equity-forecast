# Free, instant, no card: https://fredaccount.stlouisfed.org/apikeys
# Used for US macro releases (10Y yield, CPI, Fed funds) as event flags.
FRED_API_KEY=

# https://platform.openai.com/api-keys
# Only needed for the narration layer (M2). Ingest, features, modelling and the
# full walk-forward report all run without it.
OPENAI_API_KEY=
NARRATOR_MODEL=gpt-5-mini
NARRATOR_REASONING_EFFORT=low
